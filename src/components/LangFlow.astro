---
/**
 * FIG. 02 语言流向：原语言 → 我读的语言。
 * 构建时用 src/lib/flowLayout.ts 出静态 SVG（无 JS 可读）；客户端订阅联动筛选，
 * 用同一份布局函数重排，色带/节点以 CSS 过渡到新位置。
 */
import { getCollection } from 'astro:content';
import { flowRecords, otherSources, flowsFromRecords } from '../lib/stats';
import { deskLayout, mobLayout, DESK, MOB, MOB_BOT, MOB_H } from '../lib/flowLayout';
import { langLabel, BUCKET_LABELS } from '../lib/lang';

const works = await getCollection('works');
const records = flowRecords(works);
const other = otherSources(records);
const full = flowsFromRecords(records, other);
const desk = deskLayout(full);
const mob = mobLayout(full);

const label = (k: string) => (k === 'other' ? '其他语言' : langLabel(k));
const mLabel = (k: string) => BUCKET_LABELS[k as 'zh' | 'ja' | 'en' | 'other'] ?? label(k);
const rk = (l: { source: string; target: string; native: boolean }) => `${l.source}|${l.target}|${l.native ? 1 : 0}`;
const tip = (l: { source: string; target: string; value: number; native: boolean }, m = false) =>
  `${m ? mLabel(l.source) : label(l.source)} → ${label(l.target)} · ${l.value} 种${l.native ? '（原文直读）' : ''}`;

const nativeTotal = full.links.filter((l) => l.native).reduce((a, l) => a + l.value, 0);
const pct = Math.round(((full.totalWorks - nativeTotal) / full.totalWorks) * 100);
const { NW, X0, X1, W } = DESK;
const cfg = JSON.stringify({
  other: [...other],
  order: { sources: full.sources.map((n) => n.key), targets: full.targets.map((n) => n.key) },
  H: desk.H,
  total: full.totalWorks,
}).replace(/</g, '\\u003c');
---
<figure class="plate langflow" id="fig-flow">
  <header class="plate-head">
    <span class="kicker">FIG. 02 · Language flow</span>
    <h3><b class="plate-num" id="flow-pct">{pct}%</b>经由翻译抵达</h3>
    <p class="plate-lede">左边是原作的语言，右边是我实际读的版本。<span class="flow-legend mono"><i class="lg lg-tr"></i>译本 <i class="lg lg-na"></i>原文直读 <b id="flow-native">{nativeTotal}</b> 种</span></p>
  </header>

  <div class="flow-desk flow-scroll">
    <svg viewBox={`0 0 ${W} ${Math.ceil(desk.H)}`} role="img" aria-label="原语言到我读的语言的流向图" id="flow-desk">
      <text class="col-head" x={X0 + NW} y={14} text-anchor="end">原语言&nbsp;ORIG</text>
      <text class="col-head" x={X1} y={14} text-anchor="start">我读的&nbsp;MINE</text>
      <g class="ribbons">
        {desk.ribbons.map((r) => (
          <path class={`ribbon ${r.native ? 'native' : ''}`} d={r.d} data-k={rk(r)} data-s={r.source} data-t={r.target} tabindex="0" role="button" aria-label={tip(r)}><title>{tip(r)}</title></path>
        ))}
      </g>
      {desk.src.map((n) => (
        <g class="fnode src" data-k={n.key} style={`transform:translate(${X0}px,${n.y0.toFixed(1)}px)`} tabindex="0" role="button" aria-label={`只看${label(n.key)}原作`}>
          <rect class="node" width={NW} height={Math.max(n.h, 1.5)} />
          <text class="nlabel" x={-8} y={n.h / 2 + 4} text-anchor="end">{label(n.key)}<tspan class="ncount">&nbsp;{n.total}</tspan></text>
        </g>
      ))}
      {desk.tgt.map((n) => (
        <g class="fnode tgt" data-k={n.key} style={`transform:translate(${X1}px,${n.y0.toFixed(1)}px)`}>
          <rect class="node" width={NW} height={Math.max(n.h, 1.5)} />
          <text class="nlabel" x={NW + 8} y={n.h / 2 + 4} text-anchor="start">{label(n.key)}<tspan class="ncount">&nbsp;{n.total}</tspan></text>
        </g>
      ))}
    </svg>
  </div>

  <div class="flow-mob">
    <svg viewBox={`0 0 ${MOB.W} ${Math.ceil(MOB_H)}`} role="img" aria-label="原语言到我读的语言的垂直流向图" id="flow-mob">
      <text class="col-head" x={MOB.W / 2} y={28} text-anchor="middle">原语言 → 我读的 &nbsp;ORIG → MINE</text>
      <g class="ribbons">
        {mob.ribbons.map((r) => (
          <path class={`ribbon ${r.native ? 'native' : ''}`} d={r.d} data-k={rk(r)} data-s={r.source} data-t={r.target}><title>{tip(r, true)}</title></path>
        ))}
      </g>
      {mob.src.map((n) => (
        <g class="fnode src" data-k={n.key} style={`transform:translate(${n.x0.toFixed(1)}px,${MOB.TOP}px)`}>
          <rect class="node" width={Math.max(n.w, 1.5)} height={MOB.NH} rx="2" />
          <text class="mnlabel" x={n.w / 2} y={-18} text-anchor="middle">{mLabel(n.key)}<tspan class="mncount" x={n.w / 2} dy="13">{n.total}</tspan></text>
        </g>
      ))}
      {mob.tgt.map((n) => (
        <g class="fnode tgt" data-k={n.key} style={`transform:translate(${n.x0.toFixed(1)}px,${MOB_BOT}px)`}>
          <rect class="node" width={Math.max(n.w, 1.5)} height={MOB.NH} rx="2" />
          <text class="mnlabel" x={n.w / 2} y={MOB.NH + 16} text-anchor="middle">{label(n.key)}<tspan class="mncount" x={n.w / 2} dy="13">{n.total}</tspan></text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>点左侧原语言只看这种语言的书，点任意一条色带查看这条路径上的书单；各图联动。</figcaption>
  <script type="application/json" id="flow-cfg" set:html={cfg}></script>
</figure>

<script>
  import { flowsFromRecords } from '../lib/stats';
  import { deskLayout, mobLayout, DESK, MOB, MOB_BOT } from '../lib/flowLayout';
  import { langLabel, langBucket } from '../lib/lang';
  import { getState, setFilter, onFilter, getBooks, matches, type FilterState } from '../scripts/catalogFilter';

  const fig = document.getElementById('fig-flow');
  const cfgEl = document.getElementById('flow-cfg');
  if (fig && cfgEl) {
    const cfg = JSON.parse(cfgEl.textContent!) as { other: string[]; order: { sources: string[]; targets: string[] }; H: number; total: number };
    const other = new Set(cfg.other);
    const books = getBooks();
    const deskSvg = document.getElementById('flow-desk')!;
    const mobSvg = document.getElementById('flow-mob')!;
    const label = (k: string) => (k === 'other' ? '其他语言' : langLabel(k));
    const BL: Record<string, string> = { zh: '中文', ja: '日文', en: '英文', other: '其他' };

    /** 某个流向节点 key（桌面为具体语言或 other，手机为四分类）对应的全部原语言代码 */
    const langsOf = (key: string, mobile: boolean) => [...new Set(books
      .filter((b) => (mobile ? (b.sk === 'other' ? 'other' : langBucket(b.sk)) === key : b.sk === key))
      .map((b) => b.ol))];

    function apply(svg: Element, layout: ReturnType<typeof deskLayout> | ReturnType<typeof mobLayout>, mobile: boolean) {
      const rib = new Map(layout.ribbons.map((r) => [`${r.source}|${r.target}|${r.native ? 1 : 0}`, r]));
      svg.querySelectorAll<SVGPathElement>('.ribbon').forEach((p) => {
        const r = rib.get(p.dataset.k!);
        p.classList.toggle('gone', !r);
        if (r) {
          p.setAttribute('d', r.d);
          p.querySelector('title')!.textContent = `${mobile ? BL[r.source] ?? label(r.source) : label(r.source)} → ${label(r.target)} · ${r.value} 种${r.native ? '（原文直读）' : ''}`;
        }
      });
      const nodes = [...layout.src.map((n) => ['src', n] as const), ...layout.tgt.map((n) => ['tgt', n] as const)];
      const seen = new Set<string>();
      for (const [side, n] of nodes) {
        const g = svg.querySelector<SVGGElement>(`.fnode.${side}[data-k="${n.key}"]`);
        if (!g) continue;
        seen.add(side + n.key);
        g.classList.remove('gone');
        const rect = g.querySelector('rect')!;
        const tx = g.querySelector('text')!;
        const cnt = tx.querySelector('tspan')!;
        if (mobile) {
          const m = n as { x0: number; w: number };
          g.style.transform = `translate(${m.x0.toFixed(1)}px,${side === 'src' ? MOB.TOP : MOB_BOT}px)`;
          rect.setAttribute('width', String(Math.max(m.w, 1.5)));
          tx.setAttribute('x', String(m.w / 2));
          cnt.setAttribute('x', String(m.w / 2));
          cnt.textContent = String(n.total);
        } else {
          const d = n as { y0: number; h: number };
          g.style.transform = `translate(${side === 'src' ? DESK.X0 : DESK.X1}px,${d.y0.toFixed(1)}px)`;
          rect.setAttribute('height', String(Math.max(d.h, 1.5)));
          tx.setAttribute('y', String(d.h / 2 + 4));
          cnt.textContent = ' ' + n.total;
        }
      }
      svg.querySelectorAll<SVGGElement>('.fnode').forEach((g) => {
        if (!seen.has((g.classList.contains('src') ? 'src' : 'tgt') + g.dataset.k)) g.classList.add('gone');
      });
    }

    function highlight(svg: Element, s: FilterState, mobile: boolean) {
      const fk = s.flow ? `${s.flow.src}|${s.flow.tgt}|${s.flow.native ? 1 : 0}` : null;
      const srcKeys = s.langs
        ? new Set(books.filter((b) => s.langs!.includes(b.ol)).map((b) => (mobile ? (b.sk === 'other' ? 'other' : langBucket(b.sk)) : b.sk)))
        : null;
      const focused = !!(fk || srcKeys);
      svg.classList.toggle('focused', focused);
      svg.querySelectorAll<SVGPathElement>('.ribbon').forEach((p) => {
        const mobileFlowMatch = mobile && s.flow && (s.flow.src === 'other' ? 'other' : langBucket(s.flow.src)) === p.dataset.s && s.flow.tgt === p.dataset.t;
        const on = fk ? (p.dataset.k === fk || !!mobileFlowMatch) : srcKeys ? srcKeys.has(p.dataset.s!) : false;
        p.classList.toggle('lit', on);
      });
      svg.querySelectorAll<SVGGElement>('.fnode.src').forEach((g) => g.classList.toggle('lit', !!srcKeys?.has(g.dataset.k!)));
    }

    function render(s: FilterState) {
      // 本图自己的维度（langs / flow）改为高亮，其余维度照常过滤
      const recs = books.filter((b) => matches(b, s, ['langs', 'flow'])).map((b) => ({ orig: b.ol, mine: b.ml }));
      const f = flowsFromRecords(recs, other, cfg.order);
      // 书少时放大单位高度：按总量比的 0.6 次方，且不超过画布
      const ratio = f.totalWorks ? cfg.total / f.totalWorks : 1;
      const room = (cfg.H - 2 * DESK.PAD - Math.max(f.sources.length, f.targets.length) * (DESK.GAP + DESK.MIN)) / Math.max(1, f.totalWorks);
      const U = Math.max(DESK.U, Math.min(DESK.U * Math.pow(ratio, 0.6), room));
      apply(deskSvg, deskLayout(f, cfg.H, U), false);
      apply(mobSvg, mobLayout(f), true);
      highlight(deskSvg, s, false);
      highlight(mobSvg, s, true);
      // 导语数字：当前切面（含语言/流向筛选）里的译本比例
      const cur = books.filter((b) => matches(b, s));
      const nat = cur.filter((b) => b.ol === b.ml).length;
      document.getElementById('flow-pct')!.textContent = cur.length ? Math.round(((cur.length - nat) / cur.length) * 100) + '%' : '—';
      document.getElementById('flow-native')!.textContent = String(nat);
    }

    /* ---- 交互 ---- */
    const pickRibbon = (p: SVGPathElement, mobile: boolean) => {
      const [src, tgt, nat] = p.dataset.k!.split('|');
      const cur = getState().flow;
      if (mobile) {
        // 手机版色带是四分类聚合：落到该分类下的语言筛选 + 目标语言
        const langs = langsOf(src, true);
        const same = getState().langs?.join() === langs.join() && cur?.tgt === tgt;
        setFilter(same ? { langs: null, flow: null } : { langs, langsLabel: `${BL[src]}原作`, flow: null });
        return;
      }
      const same = cur && cur.src === src && cur.tgt === tgt && cur.native === (nat === '1');
      setFilter(same
        ? { flow: null }
        : { flow: { src, tgt, native: nat === '1' }, flowLabel: `${label(src)} → ${label(tgt)}${nat === '1' ? '（原文）' : ''}` });
    };
    const pickSource = (key: string, mobile: boolean) => {
      const langs = langsOf(key, mobile);
      const same = getState().langs?.slice().sort().join() === langs.slice().sort().join();
      setFilter(same ? { langs: null } : { langs, langsLabel: `${mobile ? BL[key] : label(key)}原作` });
    };
    for (const [svg, mobile] of [[deskSvg, false], [mobSvg, true]] as const) {
      svg.addEventListener('click', (e) => {
        const t = e.target as Element;
        const p = t.closest<SVGPathElement>('.ribbon');
        if (p) return pickRibbon(p, mobile);
        const g = t.closest<SVGGElement>('.fnode.src');
        if (g) pickSource(g.dataset.k!, mobile);
      });
      svg.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key !== 'Enter' && (e as KeyboardEvent).key !== ' ') return;
        const t = e.target as Element;
        if (t.classList.contains('ribbon')) { pickRibbon(t as SVGPathElement, mobile); e.preventDefault(); }
        else if (t.classList.contains('fnode')) { pickSource((t as SVGGElement).dataset.k!, mobile); e.preventDefault(); }
      });
      // 悬停节点：只亮它的色带
      svg.addEventListener('pointerover', (e) => {
        const g = (e.target as Element).closest<SVGGElement>('.fnode');
        svg.querySelectorAll('.ribbon.hover').forEach((p) => p.classList.remove('hover'));
        svg.classList.toggle('hovering', !!g);
        if (!g) return;
        const attr = g.classList.contains('src') ? 's' : 't';
        svg.querySelectorAll<SVGPathElement>(`.ribbon[data-${attr}="${g.dataset.k}"]`).forEach((p) => p.classList.add('hover'));
      });
      svg.addEventListener('pointerleave', () => { svg.classList.remove('hovering'); svg.querySelectorAll('.ribbon.hover').forEach((p) => p.classList.remove('hover')); });
    }

    onFilter(render);
    if (Object.values(getState()).some((v) => v != null)) render(getState());
  }
</script>
