---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SUBJECTS } from '../../lib/subjects';

const works = await getCollection('works');

// 每词作品数
const counts = new Map<string, number>();
for (const w of works) {
  for (const s of w.data.subjects) counts.set(s, (counts.get(s) ?? 0) + 1);
}

// 词表顺序即馆长排定的展示顺序（subjects.yaml）
const entries = SUBJECTS.map((s) => ({ ...s, count: counts.get(s.slug) ?? 0 }));
---
<Base title="主题词 · 乙椟">
  <header class="page-head wrap">
    <span class="kicker">Columns · 栏目一览</span>
    <h1>主题</h1>
    <p class="lede">受控主题词表，{entries.length} 个栏目。每本书至多收入四栏，按作品主题而不是体裁标引。</p>
  </header>

  <section class="wrap">
    <div class="columns">
      {entries.map((s, i) => (
        <a class="column-card reveal" href={`/subjects/${s.slug}/`}>
          <span class="label"><span>No. {String(i + 1).padStart(2, '0')}</span><span>{s.slug}</span></span>
          <b>{s.name}</b>
          <p>{s.desc}</p>
          <span class="n">{s.count}<small>种</small></span>
        </a>
      ))}
    </div>
  </section>
</Base>
