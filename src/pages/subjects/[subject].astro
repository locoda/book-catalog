---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langLabel, langBucket } from '../../lib/lang';

const BUCKET_CLASS = { zh: 'l-zh', ja: 'l-ja', en: 'l-en', other: 'l-ot' } as const;
import { SUBJECTS } from '../../lib/subjects';

export async function getStaticPaths() {
  // 词表 v3：URL 用 slug（冻结），显示用 name
  return SUBJECTS.map((s) => ({
    params: { subject: s.slug },
    props: { subject: s },
  }));
}

const { subject } = Astro.props;
const allWorks = await getCollection('works');

const matched = allWorks
  .filter((w) => w.data.subjects.includes(subject.slug))
  .sort((a, b) => (a.data.callno ?? '').localeCompare(b.data.callno ?? ''));

const rows = await Promise.all(matched.map(async (w) => {
  const creators = await Promise.all(w.data.creators.map((ref) => getEntry(ref)));
  const mine = w.data.expressions.find((e) => e.mine);
  return {
    id: w.id,
    data: w.data,
    creatorNames: creators.filter(Boolean).map((p) => p!.data.name).join(' · '),
    displayTitle: mine?.title ?? w.data.title,
    mineLang: mine?.lang ?? w.data.orig_lang,
    translated: mine && mine.lang !== w.data.orig_lang,
  };
}));
---
<Base title={`${subject.name} · 主题 · 乙椟`}>
  <nav class="breadcrumb wrap"><a href="/subjects/" onclick="history.back();return false">← 返回</a></nav>

  <header class="page-head wrap" style="padding-top:clamp(20px,4vw,40px)">
    <span class="kicker">Column · {subject.slug}</span>
    <h1>{subject.name}</h1>
    <p class="pull" style="max-width:720px">{subject.desc}<cite>— 栏目释义 · 收 {rows.length} 种</cite></p>
  </header>

  <section class="results wrap">
    <div id="rows">
      {rows.map((r) => (
        <a class={`row ${BUCKET_CLASS[langBucket(r.data.orig_lang)]}`} href={`/works/${r.id}/`}>
          <span class="cn">{r.data.callno ?? r.id}</span>
          <span class="tt">{r.displayTitle}{r.creatorNames && <span class="it">{r.creatorNames}</span>}</span>
          <span class="lg">
            {r.translated ? `${langLabel(r.data.orig_lang)} → ${langLabel(r.mineLang)}` : `${langLabel(r.data.orig_lang)} 原文`}
          </span>
          {r.data.rating != null
            ? <span class={`seal ${r.data.rating === 10 ? 'full' : ''}`}>{r.data.rating}</span>
            : <span class="seal none">—</span>}
        </a>
      ))}
    </div>
  </section>
</Base>
