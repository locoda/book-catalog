---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getName, subjectUrl } from '../../lib/subjects';
import { langLabel, langBucket } from '../../lib/lang';

const BUCKET_CLASS = { zh: 'l-zh', ja: 'l-ja', en: 'l-en', other: 'l-ot' } as const;

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((p) => ({ params: { id: p.id }, props: { person: p } }));
}

const { person } = Astro.props;
const works = (await getCollection('works')).filter((w) => w.data.creators.some((c) => c.id === person.id));
works.sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0));

// 著者主题摘要：去重 + 按频次排序，全部显示（侧栏 chip）
const subjectFreq = new Map<string, number>();
for (const w of works) {
  for (const s of w.data.subjects) {
    subjectFreq.set(s, (subjectFreq.get(s) ?? 0) + 1);
  }
}
const topSubjects = [...subjectFreq.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title={`${person.data.name} · 乙椟`}>
  <nav class="breadcrumb wrap"><a href="/people/" onclick="history.back();return false">← 返回</a></nav>

  <article class="wrap">
    <header class="page-head" style="padding-top:clamp(20px,4vw,40px)">
      <span class="kicker">Authority Record · p-{person.id}</span>
      <h1>{person.data.name}</h1>
      {person.data.sort && person.data.sort !== person.data.name && <p class="lede it">{person.data.sort}</p>}
      <div class="name-forms">
        {person.data.forms.sort((a, b) => a.script.localeCompare(b.script)).map((f) => (
          <div><span class="label">{f.script}</span>{f.value}</div>
        ))}
      </div>
    </header>

    <section class="results">
      <div class="sect-head"><b>{works.length}</b><span>WORKS IN CATALOG · 馆藏著作</span><em>按初版年排列</em></div>
      {works.map((w) => {
        const mine = w.data.expressions.find((e) => e.mine);
        const ml = mine?.lang ?? w.data.orig_lang;
        return (
          <a class={`row ${BUCKET_CLASS[langBucket(w.data.orig_lang)]}`} href={`/works/${w.id}/`}>
            <span class="cn">{w.data.year ?? '—'} · {w.data.callno ?? w.id}</span>
            <span class="tt">{mine?.title ?? w.data.title}{mine && mine.title !== w.data.title && <span class="it">{w.data.title}</span>}</span>
            <span class="lg">{ml === w.data.orig_lang ? `${langLabel(w.data.orig_lang)} 原文` : `${langLabel(w.data.orig_lang)} → ${langLabel(ml)}`}</span>
            {w.data.rating != null
              ? <span class={`seal ${w.data.rating === 10 ? 'full' : ''}`}>{w.data.rating}</span>
              : <span class="seal none">—</span>}
          </a>
        );
      })}
    </section>

    {topSubjects.length > 0 && (
      <section style="margin-top:clamp(32px,5vw,56px)">
        <header class="sec-head">
          <small class="mono">THEMES</small>
          <h2>常写的主题</h2>
        </header>
        <div class="subject-chips-side">
          {topSubjects.map(([slug, n]) => (
            <a class="subject-chip" href={subjectUrl(slug)}>
              {getName(slug)}<span class="mono">{n}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>
