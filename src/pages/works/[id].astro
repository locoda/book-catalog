---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langLabel } from '../../lib/lang';
import { editionLabel } from '../../lib/edition';
import { subjectUrl, getName, bySlug } from '../../lib/subjects';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((w) => ({ params: { id: w.id }, props: { work: w } }));
}

const { work } = Astro.props;
const d = work.data;

const resolved = await Promise.all(d.creators.map((ref) => getEntry(ref)));
const missing = d.creators.filter((_, i) => !resolved[i]).map((ref) => ref.id);
if (missing.length) {
  throw new Error(`「${work.id}」引用了不存在的 people 记录：${missing.join(', ')}（安全网：悬空引用阻断构建）`);
}
const creators = resolved.filter((p) => p != null);

// 每位著者的馆藏中其他作品
const allWorks = await getCollection('works');
const creatorData = creators.map((p) => ({
  person: p,
  otherWorks: allWorks.filter((w) => w.id !== work.id && w.data.creators.some((c) => c.id === p!.id)),
}));

// 主题词在全库的篇数
const subjectCount = (slug: string) => allWorks.filter((w) => w.data.subjects.includes(slug)).length;

const mine = d.expressions.find((e) => e.mine);
const displayTitle = mine?.title ?? d.title;
const showOrigSubtitle = d.title !== displayTitle;
const otherTitles = [...new Set(
  d.expressions.map((e) => e.title).filter((t) => t !== displayTitle && t !== d.title)
)].join(' · ');
const firstRead = d.readings[0]?.date?.slice(0, 4);
const lastRead = d.readings[d.readings.length - 1]?.date?.slice(0, 4);
const lastReading = d.readings[d.readings.length - 1];
const mineLang = mine?.lang ?? d.orig_lang;
const lede = d.subjects.length ? bySlug.get(d.subjects[0]) : undefined;
---
<Base title={`${displayTitle} · 乙椟`} progress>
  <nav class="breadcrumb wrap"><a href="/works/" onclick="history.back();return false">← 返回</a></nav>

  <article class="wrap">
    <header class="feature-hero">
      <div>
        {d.subjects.length > 0
          ? <span class="kicker">{d.subjects.map((s, i) => <>{i > 0 && ' · '}<a class="ulink" href={subjectUrl(s)}>{getName(s)}</a></>)}</span>
          : <span class="kicker">{d.callno ?? work.id}</span>}
        <h1>{displayTitle}</h1>
        {showOrigSubtitle && (
          <p class="orig it">{d.title}{d.year && `, ${d.year}`}<span class="mono">{langLabel(d.orig_lang)}</span></p>
        )}
        {otherTitles && <p class="alt">{otherTitles}</p>}
        <div class="byline">
          <span class="label">文</span>
          {creators.length > 0
            ? creators.map((p) => <a href={`/people/${p!.id}/`}><b>{p!.data.name}</b></a>)
            : <span class="tr">佚名 / 合集</span>}
          {mine?.translator && <span class="tr">· {mine.translator} 译</span>}
        </div>
      </div>
      <aside class="feature-side">
        {d.rating != null && <div class="bigseal" title={`评分来源：${d.rating_source}`}><b>{d.rating}</b><span>RATING</span></div>}
        <div class="spec">
          原语言 <b>{langLabel(d.orig_lang)}</b> {d.orig_lang}<br />
          初版 <b>{d.year ?? '—'}</b><br />
          我读的 <b>{mineLang === d.orig_lang ? '原文' : langLabel(mineLang)}{lastReading?.edition && ` · ${editionLabel(lastReading.edition)}`}</b><br />
          读毕 <b>{lastReading?.date ?? '—'}</b>
        </div>
      </aside>
    </header>

    <div class="feature-body">
      <div class="col">
        {d.expressions.length > 0 && (
          <>
            <h4>EXPRESSIONS · 版本</h4>
            <div class="expr-list">
              {d.expressions.map((e) => (
                <div class={e.mine ? 'mine' : ''}>
                  <span class="mono">{e.lang}</span>
                  <span>
                    {e.title}{e.mine && <span class="tag-mine">· 我读的版本</span>}
                    <small>{e.translator ? `${e.translator} 译` : e.lang === d.orig_lang ? '原文' : langLabel(e.lang)}</small>
                  </span>
                </div>
              ))}
            </div>
          </>
        )}
        {lede && (
          <p class="pull">{lede.desc}<cite>— 栏目「{lede.name}」释义</cite></p>
        )}
      </div>

      <div class="col">
        {d.readings.length > 0 && (
          <>
            <h4>READINGS · 阅读记录</h4>
            <div class="tl">
              {d.readings.map((r) => (
                <div class="tl-item">
                  <div class="d">{r.date.replace(/-/g, '.')}</div>
                  {(r.edition || r.lang) && <div class="e">{[r.edition && editionLabel(r.edition), r.lang && langLabel(r.lang)].filter(Boolean).join(' · ')}</div>}
                  {r.note && <em>{r.note}</em>}
                </div>
              ))}
            </div>
          </>
        )}
        {d.subjects.length > 0 && (
          <>
            <h4 style="margin-top:22px">SUBJECTS · 收入栏目</h4>
            <div class="subj-list">
              {d.subjects.map((s) => (
                <a href={subjectUrl(s)}><span>{getName(s)}</span><span class="mono">→ {subjectCount(s)} 种</span></a>
              ))}
            </div>
          </>
        )}
      </div>

      <div class="col col-auth">
        {creatorData.map(({ person, otherWorks }, idx) => (
          <div style={idx > 0 ? 'margin-top:32px' : ''}>
            <h4>AUTHORITY · 著者</h4>
            <a class="auth-name" href={`/people/${person!.id}/`}>{person!.data.name}</a>
            <div class="auth-forms">
              {person!.data.forms.sort((a, b) => a.script.localeCompare(b.script)).map((f) => (
                <div><span class="mono">{f.script}</span><span>{f.value}</span></div>
              ))}
              <div><span class="mono">id</span><span class="mono" style="font-size:12px">p-{person!.id}</span></div>
            </div>
            <div class="auth-count">
              馆藏中著作 <b>{otherWorks.length + 1}</b> 种
              {firstRead && <> · 阅读 <b>{firstRead}{lastRead && lastRead !== firstRead ? `–${lastRead}` : ''}</b></>}
            </div>
            <div class="further">
              <span class="label">延伸阅读 · further</span>
              {otherWorks.length > 0
                ? otherWorks.map((w) => (
                    <a href={`/works/${w.id}/`}>
                      <span>{w.data.expressions.find((e) => e.mine)?.title ?? w.data.title}</span>
                      <span class="mono">{w.data.rating != null ? `${w.data.rating} ●` : ''}</span>
                    </a>
                  ))
                : <div class="none">馆藏中暂无其他著作</div>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <footer class="page-colophon">
      <div><span class="label">索书号</span><span class="mono">{d.callno ?? '—'}</span></div>
      <div><span class="label">slug</span><span class="mono">{work.id}</span></div>
      <div><span class="label">原语言</span>{langLabel(d.orig_lang)}</div>
      <div><span class="label">初版</span>{d.year ?? '—'}</div>
      <div><span class="label">来源</span>{d.rating_source} · 手工著录{!d.confirmed && <span class="mono" style="color:var(--stamp);margin-left:8px">草</span>}</div>
    </footer>
  </article>
</Base>
