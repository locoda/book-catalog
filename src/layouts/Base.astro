---
import { getCollection } from 'astro:content';
import '../styles/catalog.css';

interface Props { title?: string; progress?: boolean }
const { title = '乙椟 · Ethercase', progress = false } = Astro.props;

const works = await getCollection('works');
const people = await getCollection('people');
const langs = new Set(works.map(w => w.data.orig_lang));
const dates = works.flatMap(w => w.data.readings.map(r => r.date)).filter(Boolean).sort();
const years = dates.map(d => parseInt(d.slice(0, 4))).filter(n => !isNaN(n));
const yearRange = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';

// 刊期：以最近一次读毕的年月为「本期」，本期新录 = 最近读毕日期落在该月的作品数
const latest = dates[dates.length - 1] ?? '';
const issueMonth = latest.slice(0, 7);
const latestOf = (w: typeof works[number]) => w.data.readings.map(r => r.date).sort().pop() ?? '';
const issueCount = issueMonth ? works.filter(w => latestOf(w).startsWith(issueMonth)).length : 0;

const path = Astro.url.pathname;
const nav = [
  { href: '/works/', label: '目录' },
  { href: '/people/', label: '著者' },
  { href: '/subjects/', label: '主题' },
];
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="乙椟 — 乙醚的私人编目，为读过的每一本书立一条目。" />
  <meta name="theme-color" content="#D8CBB2" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1A2330" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <script is:inline>
    // 首帧前恢复深浅色偏好，避免闪烁；存储不可用时跟随系统
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;1,9..144,300&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  {progress && <div class="progress" aria-hidden="true"></div>}
  <header class="site">
    <div class="header-inner">
      <a href="/" class="brand">乙椟<span class="it">Ethercase</span></a>
      {issueMonth && (
        <span class="issue">VOL. {issueMonth.slice(0, 4)} · NO. {issueMonth.slice(5, 7)} · 本期新录 <b>{issueCount}</b> 种</span>
      )}
      <nav class="site-nav">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色"></button>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site">
    <div class="colophon">
      <div><span class="label">馆藏 · works</span><b>{works.length}</b></div>
      <div><span class="label">原语言 · languages</span><b>{langs.size}</b></div>
      <div><span class="label">著者 · people</span><b>{people.length}</b></div>
      <div><span class="label">阅读跨度 · span</span><b>{yearRange || '—'}</b></div>
      <div>
        <span class="label">来源 · colophon</span>
        NeoDB · 手工著录<br />
        <a class="ulink mono" style="font-size:12px" href="https://github.com/locoda/book-catalog">locoda/book-catalog</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var root = document.documentElement;
        var cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    })();
    // 跨页过渡：点进作品详情时，把被点的题名标为共享元素，与详情页大标题衔接
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest && e.target.closest('a[href^="/works/"]');
      if (!a || a.getAttribute('href') === '/works/') return;
      var t = a.id === 'cc-go' ? document.getElementById('cc-t') : a.querySelector('.tt, .ti, h2, b');
      if (t) t.style.viewTransitionName = 'work-title';
    });
    addEventListener('pageshow', function () {
      document.querySelectorAll('[style*="view-transition-name"]').forEach(function (el) { el.style.viewTransitionName = ''; });
    });
  </script>
</body>
</html>
