---
import { getCollection } from 'astro:content';
import '../styles/catalog.css';

interface Props { title?: string }
const { title = '乙椟 · Ethercase' } = Astro.props;

const works = await getCollection('works');
const people = await getCollection('people');
const langs = new Set(works.map(w => w.data.orig_lang));
const years = works.flatMap(w => w.data.readings.map(r => parseInt(r.date.slice(0, 4)))).filter(n => !isNaN(n));
const yearRange = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="乙椟 — 乙醚的私人编目，为读过的每一本书立一条目。" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){
      try {
        const saved = localStorage.getItem('ethercase-theme');
        const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
        const theme = saved || (prefersLight ? 'light' : 'dark');
        if (theme === 'light') document.documentElement.setAttribute('data-theme','light');
      } catch(e) {}
    })();
  </script>
</head>
<body>
  <header class="site">
    <div class="header-inner">
      <a href="/" class="brand">乙椟</a>
      <nav class="site-nav">
        <a href="/works/">目录</a>
        <a href="/people/">著者</a>
        <a href="/subjects/">主题</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="切换明暗" aria-pressed="false" title="切换明暗">○</button>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site">
    <span class="stats-line"><b>{works.length}</b> works · <b>{langs.size}</b> languages · <b>{people.length}</b> people{yearRange && ` · ${yearRange}`}</span>
    <span>generated from <a href="https://github.com/locoda/book-catalog">locoda/book-catalog</a></span>
    <span>sources: NeoDB · 手工著录</span>
  </footer>
  <script is:inline>
    (function(){
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      function apply(theme){
        if (theme === 'light') document.documentElement.setAttribute('data-theme','light');
        else document.documentElement.removeAttribute('data-theme');
        try { localStorage.setItem('ethercase-theme', theme); } catch(e){}
        btn.textContent = theme === 'light' ? '●' : '○';
        btn.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
        btn.title = theme === 'light' ? '切换到暗色' : '切换到亮色';
      }
      try {
        const saved = localStorage.getItem('ethercase-theme');
        const current = document.documentElement.getAttribute('data-theme') || (saved === 'light' ? 'light' : 'dark');
        apply(current);
      } catch(e){}
      btn.addEventListener('click', () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        apply(isLight ? 'dark' : 'light');
      });
    })();
  </script>
</body>
</html>
